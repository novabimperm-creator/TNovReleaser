<Window x:Class="TNovReleaser.Views.FileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор файлов для релиза"
        Height="500"
        Width="900"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <CheckBox x:Name="Release2022CheckBox"
                      Content="2022"
                      IsChecked="True"
                      Margin="0,0,20,0" />
            <CheckBox x:Name="Release2027CheckBox"
                      Content="2027"
                      IsChecked="True"
                      Margin="0,0,40,0" />
            <CheckBox x:Name="DuplicateToShareCheckBox"
                      Content="Дублировать на шару"
                      ToolTip="Кроме GitHub, скопировать файлы в actual\ на шарах офисов (старые клиенты и резерв при недоступном GitHub)"
                      IsChecked="False"
                      Margin="0,0,20,0" />
            <CheckBox x:Name="PublishPersonalCheckBox"
                      Content="Опубликовать в личную"
                      ToolTip="Обновить личный манифест на GitHub Pages"
                      IsChecked="False" />
        </StackPanel>

        <DataGrid x:Name="FilesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFD0D0D0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выбрать"
                                        Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70" />
                <DataGridTextColumn Header="Файл"
                                    Binding="{Binding FileName}"
                                    IsReadOnly="True"
                                    Width="*" />
                <DataGridTextColumn Header="Примечание к релизу"
                                    Binding="{Binding ReleaseNote, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="100"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="OnOkClick" />
            <Button Content="Отмена"
                    Width="100"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
